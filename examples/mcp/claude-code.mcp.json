{
  "mcpServers": {
    "gofer-trace": {
      "type": "stdio",
      "command": "python",
      "args": ["agent/mcp_server.py"],
      "env": {
        "API_BASE": "http://localhost:8001"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    }
  }
}
