# Gofer Trace configuration — copy to .env and adjust.
# Every value has a safe local default; you only need to set what differs.
# See backend/settings.py and docs/ARCHITECTURE.md §4.

# Deployment profile: local (offline-capable) or cloud.
GOFER_PROFILE=local

# Backend HTTP base — used by the MCP server (agent/) and the Gradio Space.
# Local default: http://localhost:8001 ; Cloud: your deployed backend URL.
GOFER_API_BASE=http://localhost:8001

# Knowledge-base backend: file (JSON on disk, no infra) or graph (Memgraph/Neo4j).
GOFER_KB=file

# Knowledge-base graph (used when GOFER_KB=graph). Bolt works for both engines:
#   local  → Memgraph:      bolt://localhost:7687
#   cloud  → Neo4j/AuraDB:  neo4j+s://<id>.databases.neo4j.io
GOFER_GRAPH_URL=bolt://localhost:7687
GOFER_GRAPH_USER=
GOFER_GRAPH_PASSWORD=
# Optional named database (Neo4j only; leave blank for Memgraph).
GOFER_GRAPH_DATABASE=

# Understanding model (id or label).
GOFER_VLM=Qwen/Qwen2.5-VL-7B-Instruct

# Embeddings for semantic search (Phase 2):
#   hashing               → offline, zero-dependency default (bag-of-words vectors)
#   sentence-transformers → true semantic vectors via a local model (heavier)
GOFER_EMBEDDINGS=hashing
GOFER_EMBEDDING_MODEL=all-MiniLM-L6-v2
GOFER_EMBEDDING_DIM=256

# Blob root: filesystem path (local) or object-store prefix like s3://bucket (cloud).
GOFER_BLOB_ROOT=./data

# --- Cloud hardening (Phase 4) ---
# Auth: enforced automatically when GOFER_PROFILE=cloud; force with GOFER_REQUIRE_AUTH.
GOFER_REQUIRE_AUTH=false
# API keys as "key:principal" pairs (principal defaults to the key). Comma-separated.
#   GOFER_API_KEYS=sk_alice:alice,sk_bob:bob
GOFER_API_KEYS=

# Object storage for artifacts: local (filesystem) or s3 (S3 / Cloudflare R2).
GOFER_BLOB_STORE=local
GOFER_S3_BUCKET=
GOFER_S3_ENDPOINT=
GOFER_S3_REGION=
GOFER_S3_PUBLIC_BASE=

# Run /analyze in the background by default (returns a job_id; poll /jobs/{id}).
GOFER_ASYNC_INGEST=false
